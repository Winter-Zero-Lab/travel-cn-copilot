# Copy to .env. NEVER commit .env — it is in .gitignore.
#
# LLM_API_KEY is OPTIONAL. Leave it empty (or as the placeholder below) to run the
# demo fully offline from the baked cases in app/demo_cases.py — no model calls at all.
# Set a real key only if you want the live "upload your own photo" path to use the model.
LLM_API_KEY=
LLM_BASE_URL=https://www.micuapi.ai/v1
LLM_MODEL=glm-5.3-flash
LLM_TIMEOUT=60
PORT=8000
